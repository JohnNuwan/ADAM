# ADAM Docker Stack — Configuration
POSTGRES_DB=adam
POSTGRES_USER=adam
POSTGRES_PASSWORD=adam_secret_2026
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# [FIX 6] Unified port for go-bus. The HTTP API and internal NATS-like
# bus both run on the same port (8086), matching docker-compose.yml.
# Previously GO_BUS_PORT=4222 and GO_BUS_HTTP_PORT=8080 contradicted
# the docker-compose hardcoded 8086, causing client/agent confusion.
GO_BUS_PORT=8086
GO_BUS_HTTP_PORT=8086

AGENT_VIZ_PORT=8084
AGENT_CHAT_PORT=8085

TZ=Europe/Paris

# GitHub (optionnel pour git-sync)
GIT_REMOTE=git@github.com:JohnNuwan/ADAM.git
